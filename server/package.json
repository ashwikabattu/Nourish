{
  "name": "nourish-api",
  "version": "1.0.0",
  "description": "REST API for the Nourish nutrition tracker",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "type": "module",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
