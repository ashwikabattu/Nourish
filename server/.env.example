# Copy to .env for local development. Every value is optional locally.
PORT=3000
# Leave DATABASE_URL unset to use an embedded Postgres (PGlite) stored in ./.data
# DATABASE_URL=postgres://nourish:nourish@localhost:5432/nourish
# Path to a CA bundle for TLS to the database (set automatically in the Docker image for AWS RDS)
# DATABASE_SSL_CA=/app/rds-ca.pem
JWT_SECRET=dev-only-secret-change-me-in-production-please
# Free key from https://fdc.nal.usda.gov/api-key-signup (1,000 requests/hour). Without it, DEMO_KEY is used.
# FDC_API_KEY=


